<Window x:Class="hAItedetector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="hAItedetector"
        Height="600" Width="900"
        Icon="Assets\icon.png"
        Background="#1E1E1E"
        Foreground="#D0D0D0"
        FontFamily="Microsoft JhengHei UI"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ── Culori ─────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BrushBackground"  Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrushSurface"     Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BrushBorder"      Color="#3D3D3D"/>
        <SolidColorBrush x:Key="BrushAccent"      Color="#E8177A"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="BrushTextMuted"   Color="#888888"/>

        <!-- ── Stil buton ─────────────────────────────────────────── -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background"        Value="#2D2D2D"/>
            <Setter Property="Foreground"        Value="#D0D0D0"/>
            <Setter Property="BorderBrush"       Value="#3D3D3D"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="FontFamily"        Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Height"            Value="35"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D"/>
                                <Setter Property="BorderBrush" Value="#E8177A"/>
                            </Trigger>
                            <!-- apăsat -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E8177A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- dezactivat -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Stil buton accent (roz) ───────────────────────────── -->
        <Style x:Key="AccentButton" TargetType="Button"
               BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background"  Value="#E8177A"/>
            <Setter Property="Foreground"  Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E8177A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2D8F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C01060"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Stil ListView ─────────────────────────────────────── -->
        <Style x:Key="DarkListView" TargetType="ListView">
            <Setter Property="Background"       Value="#2D2D2D"/>
            <Setter Property="BorderBrush"      Value="#3D3D3D"/>
            <Setter Property="Foreground"       Value="#D0D0D0"/>
            <Setter Property="FontFamily"       Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="BorderThickness"  Value="1"/>
        </Style>

        <!-- ── Stil GridViewColumnHeader ─────────────────────────── -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"   Value="#1E1E1E"/>
            <Setter Property="Foreground"   Value="#E8177A"/>
            <Setter Property="FontFamily"   Value="Microsoft JhengHei UI"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderBrush"  Value="#3D3D3D"/>
            <Setter Property="Padding"      Value="8,4"/>
        </Style>

        <!-- ── Stil ListViewItem ─────────────────────────────────── -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground"       Value="#D0D0D0"/>
            <Setter Property="FontFamily"       Value="Microsoft JhengHei UI"/>
            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
            <Setter Property="BorderBrush"      Value="#3D3D3D"/>
            <Setter Property="Padding"          Value="4,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383838"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3D1A2A"/>
                    <Setter Property="BorderBrush" Value="#E8177A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- LAYOUT PRINCIPAL-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ─────────────────────────────────────────── -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2"
              Background="#252525">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="ImgLogo"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   Margin="12,8"
                   Source="Assets/logo.png"
                   Stretch="Uniform"/>

            <!-- Status server -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12">
                <Ellipse x:Name="StatusDot"
                         Width="10" Height="10"
                         Fill="#888888"
                         Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtStatus"
                           Text="Checking server status..."
                           Foreground="#888888"
                           FontFamily="Microsoft JhengHei UI"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Linie separatoare sub header -->
        <Rectangle Grid.Row="0" Grid.ColumnSpan="2"
                   Height="1" Fill="#E8177A"
                   VerticalAlignment="Bottom"/>

        <!-- ── STÂNGA — panou butoane ─────────────────────────── -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#252525"
                BorderBrush="#3D3D3D"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="12,16,12,0"
                        VerticalAlignment="Top">

                <Button x:Name="BtnImport"
                        Content="⬆ Import"
                        Style="{StaticResource DarkButton}"
                        Margin="0,0,0,10"
                        Click="BtnImport_Click"/>

                <Button x:Name="BtnAnalyze"
                        Content="▶ Analyze"
                        Style="{StaticResource AccentButton}"
                        IsEnabled="False"
                        Click="BtnAnalyze_Click"/>

            </StackPanel>
        </Border>

        <!-- ── DREAPTA — lista mesaje ─────────────────────────── -->
        <ScrollViewer Grid.Row="1" Grid.Column="1"
              VerticalScrollBarVisibility="Auto"
              Background="#1E1E1E"
              Margin="10">
            <StackPanel x:Name="MessagesPanel"
                Margin="4"/>
        </ScrollViewer>

        <!-- ── FOOTER — buton Settings ───────────────────────── -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="#252525"
                BorderBrush="#3D3D3D"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button x:Name="BtnExport"
                Content="Export CSV"
                Style="{StaticResource DarkButton}"
                Width="110"
                Margin="0,0,5,0"
                Click="BtnExport_Click"/>
                <Button x:Name="BtnSettings"
                Content="Settings"
                Style="{StaticResource DarkButton}"
                Width="110"
                Margin="0,0,5,0"
                Click="BtnSettings_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>